# VOXLY AI Desktop Assistant Environment Configuration

# OpenAI API Key (Required for ChatGPT-like AI intelligence & function calling)
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Default AI Model
OPENAI_MODEL=gpt-4o-mini

# Voice Settings
DEFAULT_VOICE_RATE=175
DEFAULT_VOICE_VOLUME=1.0
WAKE_WORD_ENABLED=true
AUTO_LISTEN_ON_START=true

# Application Paths & Settings
APP_THEME=dark
ACCENT_COLOR=#7c3aed
VOXLY_DB_PATH=voxly.db
